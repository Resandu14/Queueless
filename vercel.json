{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/[...path].js"
        },
        {
            "src": "/",
            "dest": "/queless.html"
        },
        {
            "src": "/business/?",
            "dest": "/business-portal/index.html"
        },
        {
            "src": "/business-portal/?",
            "dest": "/business-portal/index.html"
        },
        {
            "src": "/dashboard.html",
            "dest": "/business-portal/dashboard.html"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}
